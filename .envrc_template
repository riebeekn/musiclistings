# This is a template file containing the environment settings
# required to run the application.  Copy this file to .envrc
# and update the setting values if desired

# You will need to run source .envrc from your terminal prior to starting
# the application.  Or install https://direnv.net/docs/installation.html
export ADMIN_EMAIL="admin@example.com"

# Render's EXTERNAL postgres connection string. Used by bin/pull-prod-db.sh (to pull
# prod data down locally) and bin/crawl-venue.sh (to crawl a venue from this machine
# and write the results to prod). Requires your IP to be on the Render database's
# inbound allowlist.
export PROD_DB_URL="postgresql://user:password@host.render.com/database"

# Brevo API key, used by bin/crawl-venue.sh to email the crawl report to
# ADMIN_EMAIL (set above) the same way the nightly crawl does. Only needed for
# USE_PROD_DB=true runs; plain dev drops mail in http://localhost:4000/dev/mailbox.
export BREVO_API_KEY=""

# Optional: path to the curl-impersonate binary used for venues behind a
# Cloudflare challenge (Massey Hall, Roy Thomson Hall, TD Music Hall). Only
# needed if it isn't on your PATH or in bin/curl-impersonate/ (where
# bin/install-curl-impersonate.sh puts it).
# export CURL_IMPERSONATE_BIN=""

# Impact.com credentials for the TicketNetwork affiliate catalog, used to attach
# affiliate ticket links to events after each crawl (see
# MusicListings.Affiliates.TicketNetwork).
# Leave unset to skip affiliate matching entirely.
export TICKET_NETWORK_ACCOUNT_SID=""
export TICKET_NETWORK_AUTH_TOKEN=""
